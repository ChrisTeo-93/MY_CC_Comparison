{
  "expo": {
    "name": "KadCompare",
    "slug": "kadcompare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kadcompare",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kadcompare.app",
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.kadcompare.app",
      "adaptiveIcon": {
        "backgroundColor": "#ccfbf1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f766e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Find the Malaysian credit card, or combination of cards, that earns you the most for the way you actually spend.",
    "primaryColor": "#0f766e"
  }
}
